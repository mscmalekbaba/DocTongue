# =============================================================================
# DocTongue backend configuration
# Loaded by backend/app/core/config.py and by docker-compose (env_file).
# Copy from .env.example and fill in the credentials section below.
# =============================================================================

# -----------------------------------------------------------------------------
# Credentials - the only secrets in this file
# -----------------------------------------------------------------------------
# OpenRouter serves both chat and embeddings. Required unless LLM_PROVIDER=stub
# and EMBEDDING_PROVIDER=local. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Only needed by the optional deepeval judge (QUALITY_CONTROL_ENABLED=1).
OPENAI_API_KEY=
# Per-service overrides of OPENROUTER_API_KEY. Leave empty to use the key above.
LLM_API_KEY=
EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# OpenRouter gateway
# -----------------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers (HTTP-Referer / X-Title) shown on OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=DocTongue

# -----------------------------------------------------------------------------
# Answer generation
# -----------------------------------------------------------------------------
# "openrouter", or "stub" for templated answers with no API key.
LLM_PROVIDER=stub
# OpenRouter model slug, e.g. nvidia/nemotron-3.5-super-vl:free,
# openai/gpt-4o-mini, anthropic/claude-3.5-sonnet.
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
MAX_ANSWER_CITATIONS=3

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# "openrouter", or "local" for the zero-key hash fallback.
EMBEDDING_PROVIDER=local
# nvidia/nemotron-3.5-embed-8b:free is free and multilingual; it is natively
# 4096-dim and supports truncation to EMBEDDING_DIMENSIONS.
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
EMBEDDING_DIMENSIONS=256
# Send `dimensions`. Set to 0 for models without truncation support, then set
# EMBEDDING_DIMENSIONS to the model native width.
EMBEDDING_SEND_DIMENSIONS=1
# Send the search_query/search_document `input_type` hint. Required for correct
# retrieval on asymmetric models such as Nemotron. Set to 0 for endpoints that
# reject the field (OpenAI own API among them).
EMBEDDING_INPUT_TYPE=1
# Optional: point embeddings at a non-OpenRouter OpenAI-compatible service.
EMBEDDING_API_BASE=

# -----------------------------------------------------------------------------
# Chunking and retrieval
# -----------------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=5
CHROMA_COLLECTION_NAME=documents

# -----------------------------------------------------------------------------
# Quality control (optional deepeval judge)
# -----------------------------------------------------------------------------
QUALITY_CONTROL_ENABLED=0
QUALITY_CONTROL_THRESHOLD=0.5
QUALITY_CONTROL_FAIL_OPEN=1
QUALITY_CONTROL_INCLUDE_REASON=1

# -----------------------------------------------------------------------------
# Chat memory (Redis)
# -----------------------------------------------------------------------------
CHAT_MEMORY_WINDOW=3
CHAT_MEMORY_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_KEY_PREFIX=doctongue:chat

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=DocTongue API
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# Storage paths
# -----------------------------------------------------------------------------
# Left unset on purpose: config.py defaults these to absolute paths under
# backend/data, which resolve correctly no matter which directory you launch
# from. docker-compose overrides them with /app/data. Setting them to relative
# paths here breaks whenever the working directory is not the repo root.
# STORAGE_ROOT=
# UPLOADS_DIR=
# CHROMA_DIR=
# DOCUMENTS_MANIFEST=
# CHAT_AUDIT_LOG_PATH=

# -----------------------------------------------------------------------------
# Tests
# -----------------------------------------------------------------------------
# Set to 1 to run the live OpenRouter smoke test against the real API.
RUN_LIVE_LLM_SMOKE_TEST=0

# -----------------------------------------------------------------------------
# Frontend (read by docker-compose / the Next.js build, not by the backend)
# -----------------------------------------------------------------------------
BACKEND_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=
